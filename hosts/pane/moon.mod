name = "moonbitstack/moonpane"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonegui"

license = "Apache-2.0"

keywords = [
  "gui",
  "ui",
  "immediate-mode",
  "canvas",
  "canvas2d",
  "dom",
  "html",
  "h5",
  "web",
  "browser",
  "wasm",
  "js",
  "javascript",
  "host",
  "backend",
  "surface",
  "pointer",
  "keyboard",
  "input",
  "layout",
  "text",
  "graphics",
  "moonegui",
  "moonbit",
]

description = "The browser host for moonegui: one frame painted on a canvas or built as DOM elements."

preferred_target = "js"

import {
  "moonbitstack/moonegui@0.2.2",
}

source = "src"
